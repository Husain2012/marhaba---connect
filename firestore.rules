rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isChatMember(chatId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
    }

    function isValidUserPublic(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'photoURL', 'bio', 'isOnline',
          'isDiscoverable', 'language', 'lastSeen', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'bio', 'isOnline',
          'isDiscoverable', 'language', 'lastSeen', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.photoURL is string && data.photoURL.size() <= 512
        && data.bio is string && data.bio.size() <= 160
        && data.isOnline is bool
        && data.isDiscoverable is bool
        && data.language in ['ar', 'en']
        && data.lastSeen is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'phone', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() <= 254
        && data.phone is string && data.phone.size() <= 32
        && data.updatedAt is timestamp;
    }

    function isValidChat(data, chatId) {
      return data.keys().hasAll([
          'id', 'type', 'name', 'createdBy', 'memberIds',
          'lastMessageText', 'lastMessageType', 'lastMessageSenderId',
          'lastMessageAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'type', 'name', 'createdBy', 'memberIds',
          'lastMessageText', 'lastMessageType', 'lastMessageSenderId',
          'lastMessageAt', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == chatId && isValidId(data.id)
        && data.type in ['direct', 'group']
        && data.name is string && data.name.size() <= 80
        && data.createdBy is string && isValidId(data.createdBy)
        && data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 50
        && data.memberIds[0] is string
        && data.lastMessageText is string && data.lastMessageText.size() <= 500
        && data.lastMessageType in ['text', 'image', 'file', 'audio', 'call']
        && data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128
        && data.lastMessageAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMember(data, memberUid) {
      return data.keys().hasAll(['uid', 'role', 'muted', 'joinedAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'role', 'muted', 'joinedAt', 'updatedAt'])
        && data.uid is string && data.uid == memberUid && isValidId(data.uid)
        && data.role in ['owner', 'member']
        && data.muted is bool
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMessage(data, chatId, messageId) {
      return data.keys().hasAll([
          'id', 'chatId', 'senderId', 'senderName', 'memberIds', 'type',
          'text', 'mediaUrl', 'fileName', 'fileSize', 'mimeType',
          'audioDurationSec', 'replyToId', 'replyToPreview', 'readBy',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'chatId', 'senderId', 'senderName', 'memberIds', 'type',
          'text', 'mediaUrl', 'fileName', 'fileSize', 'mimeType',
          'audioDurationSec', 'replyToId', 'replyToPreview', 'readBy',
          'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == messageId && isValidId(data.id)
        && data.chatId is string && data.chatId == chatId && isValidId(data.chatId)
        && data.senderId is string && isValidId(data.senderId)
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 50
        && data.memberIds[0] is string
        && data.type in ['text', 'image', 'file', 'audio', 'call']
        && data.text is string && data.text.size() <= 4000
        && data.mediaUrl is string && data.mediaUrl.size() <= 512
        && data.fileName is string && data.fileName.size() <= 180
        && data.fileSize is number && data.fileSize >= 0 && data.fileSize <= 26214400
        && data.mimeType is string && data.mimeType.size() <= 120
        && data.audioDurationSec is number && data.audioDurationSec >= 0 && data.audioDurationSec <= 3600
        && data.replyToId is string && data.replyToId.size() <= 128
        && data.replyToPreview is string && data.replyToPreview.size() <= 160
        && data.readBy is list && data.readBy.size() >= 1 && data.readBy.size() <= 50
        && data.readBy[0] is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCall(data, callId) {
      return data.keys().hasAll([
          'id', 'chatId', 'callerId', 'callerName', 'calleeId', 'calleeName',
          'participantIds', 'callType', 'status', 'durationSec', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'chatId', 'callerId', 'callerName', 'calleeId', 'calleeName',
          'participantIds', 'callType', 'status', 'durationSec', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == callId && isValidId(data.id)
        && data.chatId is string && isValidId(data.chatId)
        && data.callerId is string && isValidId(data.callerId)
        && data.callerName is string && data.callerName.size() >= 1 && data.callerName.size() <= 80
        && data.calleeId is string && isValidId(data.calleeId)
        && data.calleeName is string && data.calleeName.size() >= 1 && data.calleeName.size() <= 80
        && data.participantIds is list && data.participantIds.size() == 2
        && data.participantIds[0] is string && data.participantIds[1] is string
        && data.callType in ['audio', 'video']
        && data.status in ['ringing', 'active', 'ended', 'missed', 'declined']
        && data.durationSec is number && data.durationSec >= 0 && data.durationSec <= 86400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /test/connection {
      allow get: if isSignedIn();
    }

    // Public user profiles (PII-free)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && resource.data.isDiscoverable == true;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPublic(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPublic(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'bio', 'isOnline', 'isDiscoverable',
          'language', 'lastSeen', 'updatedAt'
        ]);
      allow delete: if false;

      // Isolated PII subcollection
      match /private/{docId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(docId) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivate(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivate(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'updatedAt']);
        allow delete: if false;
      }
    }

    // Conversations
    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) && (resource == null || request.auth.uid in resource.data.memberIds);
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isVerifiedUser()
        && isValidId(chatId)
        && isValidChat(incoming(), chatId)
        && incoming().createdBy == request.auth.uid
        && request.auth.uid in incoming().memberIds
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().lastMessageAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(chatId)
        && request.auth.uid in existing().memberIds
        && isValidChat(incoming(), chatId)
        && incoming().id == existing().id
        && incoming().type == existing().type
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update last message preview
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'lastMessageText', 'lastMessageType', 'lastMessageSenderId', 'lastMessageAt', 'updatedAt'
            ])
            && incoming().lastMessageSenderId == request.auth.uid
            && incoming().lastMessageAt == request.time
          ) ||
          // Action: Group owner updates group name or members
          (
            existing().type == 'group'
            && existing().createdBy == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'memberIds', 'updatedAt'])
            && request.auth.uid in incoming().memberIds
          )
        );
      allow delete: if false;

      // Chat membership subcollection
      match /members/{memberUid} {
        allow get: if isSignedIn() && isValidId(chatId) && isValidId(memberUid) && isChatMember(chatId);
        allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(chatId)
          && isValidId(memberUid)
          && isValidChatMember(incoming(), memberUid)
          && isChatMember(chatId)
          && incoming().joinedAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(chatId)
          && isValidId(memberUid)
          && isOwner(memberUid)
          && isChatMember(chatId)
          && isValidChatMember(incoming(), memberUid)
          && incoming().uid == existing().uid
          && incoming().role == existing().role
          && incoming().joinedAt == existing().joinedAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['muted', 'updatedAt']);
        allow delete: if false;
      }

      // Chat messages subcollection
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(chatId) && isValidId(messageId) && isChatMember(chatId);
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberIds;
        allow create: if isVerifiedUser()
          && isValidId(chatId)
          && isValidId(messageId)
          && isValidMessage(incoming(), chatId, messageId)
          && incoming().senderId == request.auth.uid
          && isChatMember(chatId)
          && incoming().memberIds == get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds
          && request.auth.uid in incoming().readBy
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(chatId)
          && isValidId(messageId)
          && isChatMember(chatId)
          && isValidMessage(incoming(), chatId, messageId)
          && incoming().id == existing().id
          && incoming().chatId == existing().chatId
          && incoming().senderId == existing().senderId
          && incoming().senderName == existing().senderName
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['readBy', 'updatedAt'])
          && request.auth.uid in incoming().readBy
          && incoming().readBy.hasAll(existing().readBy);
        allow delete: if false;
      }
    }

    // Call history and status
    match /calls/{callId} {
      allow get: if isSignedIn() && isValidId(callId) && (resource == null || request.auth.uid in resource.data.participantIds);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isVerifiedUser()
        && isValidId(callId)
        && isValidCall(incoming(), callId)
        && incoming().callerId == request.auth.uid
        && incoming().callerId in incoming().participantIds
        && incoming().calleeId in incoming().participantIds
        && incoming().status == 'ringing'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(callId)
        && request.auth.uid in existing().participantIds
        && existing().status in ['ringing', 'active']
        && isValidCall(incoming(), callId)
        && incoming().id == existing().id
        && incoming().chatId == existing().chatId
        && incoming().callerId == existing().callerId
        && incoming().calleeId == existing().calleeId
        && incoming().participantIds == existing().participantIds
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'durationSec', 'updatedAt']);
      allow delete: if false;
    }
  }
}
